# Agent Foundry .gitignore

# User-specific skills (not tracked in repo)
skills/claude/*
skills/codex/*
skills/gemini/*
!skills/*/.gitkeep

# VM images and runtime data
*.ext4
*.qcow2
vmlinux
*.img

# Logs
*.log
logs/

# Temporary files
*.tmp
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.o
*.so
*.a

# Configuration (user-specific)
config/user.conf

# IDE and editor
.vscode/
.idea/
*.sublime-*

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
test-output/
coverage/

# Runtime registry (user-specific)
vms.json

# Backup files
*.bak
*.backup
