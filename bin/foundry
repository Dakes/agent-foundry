#!/usr/bin/env bash
#
# Agent Foundry - Main CLI
#
# Host-based management tool for Docker Sandboxes running AI agents.
#
# Usage: foundry <command> [project] [options]
#
# Commands:
#   init/up/down  - project lifecycle (sandbox + policy + repos + agent)
#   status/logs   - inspection
#   attach/shell  - enter a running sandbox
#   rm/doctor     - teardown and diagnostics
#   policy/image  - escape hatches over sbx and the agent image
#

set -euo pipefail

# ============================================================================
# INITIALIZATION
# ============================================================================

# Determine script location and install prefix
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Allow override via FOUNDRY_BASE_DIR (set by release bundles)
FOUNDRY_BASE="${FOUNDRY_BASE_DIR:-$(realpath "${SCRIPT_DIR}/..")}"
FOUNDRY_LIB_DIR="${FOUNDRY_LIB_DIR:-}"

resolve_lib_dir() {
    local lib_candidate
    for lib_candidate in "$@"; do
        if [[ -z "$lib_candidate" ]]; then
            continue
        fi
        local resolved
        if resolved=$(realpath -m "$lib_candidate" 2>/dev/null); then
            lib_candidate="$resolved"
        fi
        if [[ -d "$lib_candidate" ]]; then
            echo "$lib_candidate"
            return 0
        fi
    done
    return 1
}

# Source library modules (search both repo and install locations)
LIB_DIR=$(resolve_lib_dir \
    "$FOUNDRY_LIB_DIR" \
    "${FOUNDRY_BASE}/lib/foundry" \
    "${FOUNDRY_BASE}/lib" \
    "${SCRIPT_DIR}/../lib")

if [[ -z "$LIB_DIR" ]]; then
    echo "Unable to locate Agent Foundry libraries" >&2
    exit 1
fi

source "${LIB_DIR}/utils.sh"
source "${LIB_DIR}/config.sh"

# Sandbox stack (Docker Sandboxes)
source "${LIB_DIR}/sandbox.sh"
source "${LIB_DIR}/policy.sh"
source "${LIB_DIR}/project.sh"
source "${LIB_DIR}/agent-sandbox.sh"
source "${LIB_DIR}/watcher.sh"
source "${LIB_DIR}/commands.sh"

# Enable color output by default
export COLOR_OUTPUT="${COLOR_OUTPUT:-true}"

# Version (read from VERSION file, fallback to 0.1.0)
if [[ -f "${FOUNDRY_BASE}/VERSION" ]]; then
    FOUNDRY_VERSION=$(tr -d '[:space:]' < "${FOUNDRY_BASE}/VERSION")
else
    FOUNDRY_VERSION="0.1.0"
fi

# ============================================================================
# HELP FUNCTIONS
# ============================================================================

show_version() {
    echo "Agent Foundry v${FOUNDRY_VERSION}"
}

show_help() {
    cat << 'EOF'
Agent Foundry - isolated Docker Sandboxes for AI agents

USAGE:
    foundry <command> [project] [options]
    foundry [--help | --version]

The project is inferred from the current directory when omitted.

COMMANDS:
    init <project>      Create volume root, config, policy rules and sandbox,
                        then clone declared repos inside it
    up [project]        Start sandbox, publish ports, clone missing repos,
                        start the agent (idempotent - run it any time)
    down [project]      Stop agent and sandbox, keeping all state
    status [project]    Sandbox, agent, repos, ports and policy; no project
                        lists everything
    logs [project]      Agent, watcher and receiver logs together, each line
                        tagged with its source (-f follows; --agent,
                        --watcher, --receiver narrow it; -n sets the lines)
    attach [project]    Attach to the agent's tmux session
    shell [project]     Shell inside the sandbox (--ssh to use ssh)
    rm [project]        Remove the sandbox; the volume root is kept
    doctor [project]    Check host, policy, ports and keys (--fix repairs)

    watcher <action>    start | stop | restart | status | logs |
                        register | unregister | list
    policy <action>     baseline | allow | deny | check | ls
    image <action>      build | push
    config <action>     get | set | edit | show

GLOBAL OPTIONS:
    -h, --help      Show this help message
    -v, --version   Show version
    --verbose       Enable verbose output
    --dry-run       Show what would be done without executing

EXAMPLES:
    foundry doctor --fix                  # set up the host and policy baseline
    foundry init pocetude                 # scaffold + sandbox + clone
    $EDITOR ~/.local/share/foundry/volumes/pocetude/.ssh/config
    foundry up                            # from inside the project
    foundry status
    foundry logs -f                       # agent + watcher + receiver
    foundry shell

Documentation:
    https://github.com/yourusername/agent-foundry
EOF
}

show_config_help() {
    cat << 'EOF'
foundry config - Configuration management

USAGE:
    foundry config <action> [args...]

ACTIONS:
    get <key>           Get configuration value
    set <key> <value>   Set configuration value
    edit                Edit configuration in $EDITOR
    show                Show all configuration

EXAMPLES:
    foundry config get default.cpus
    foundry config set default.memory_mb 16384
    foundry config edit
EOF
}

# ============================================================================
# COMMAND ROUTING
# ============================================================================

cmd_config() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        get)
            config_get "$@"
            ;;
        set)
            config_set "$@"
            ;;
        edit)
            config_edit
            ;;
        show|list)
            config_load
            echo "=== Configuration ==="
            local _config_home
            _config_home="$(resolve_host_home)"
            if [[ -f "${FOUNDRY_CONFIG_DIR:-${_config_home}/.config/foundry}/config.conf" ]]; then
                cat "${FOUNDRY_CONFIG_DIR:-${_config_home}/.config/foundry}/config.conf"
            else
                echo "No user configuration (using defaults)"
            fi
            ;;
        help|--help|-h)
            show_config_help
            ;;
        *)
            log_error "Unknown config action: $action"
            echo "Run 'foundry config help' for usage"
            return 1
            ;;
    esac
}

# ============================================================================

main() {
    # Parse global options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            --verbose)
                export VERBOSE=true
                shift
                ;;
            --dry-run)
                export DRY_RUN=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                echo "Run 'foundry --help' for usage"
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # The user's config carries DEFAULT_CPUS, DEFAULT_MEMORY,
    # FOUNDRY_IMAGE_REPO and FOUNDRY_PRIVATE_RANGES. It was only ever loaded
    # by 'config show', so every one of those documented knobs was ignored by
    # the commands that read them. Load it before dispatching; the environment
    # still wins, because config_load only fills what is unset.
    config_load

    # Get domain
    local domain="${1:-help}"
    shift || true

    # Route to command handler.
    case "$domain" in
        init)
            cmd_init "$@"
            ;;
        up)
            cmd_up "$@"
            ;;
        down)
            cmd_down "$@"
            ;;
        status|st)
            cmd_status "$@"
            ;;
        logs|log)
            cmd_logs "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        shell|sh)
            cmd_shell "$@"
            ;;
        rm|remove)
            cmd_rm "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        policy)
            cmd_policy "$@"
            ;;
        image|img)
            cmd_image "$@"
            ;;
        watcher)
            cmd_watcher "$@"
            ;;
        vm|agent|workspace|ws|template|tpl|host|network|net)
            log_error "'foundry ${domain}' was removed with the Firecracker backend."
            echo "" >&2
            echo "  vm         -> foundry init / up / down / status / shell / rm" >&2
            echo "  agent      -> foundry up / down / attach / logs" >&2
            echo "  workspace  -> the volume root is the workspace; edit it directly" >&2
            echo "  template   -> foundry image build" >&2
            echo "  host       -> foundry doctor --fix" >&2
            echo "  network    -> foundry policy" >&2
            exit 1
            ;;
        config|cfg)
            cmd_config "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            log_error "Unknown domain: $domain"
            echo ""
            echo "Commands: init, up, down, status, logs, attach, shell, rm, doctor, watcher, policy, image, config"
            echo "Run 'foundry --help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
