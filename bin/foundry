#!/usr/bin/env bash
#
# Agent Foundry - Main CLI
#
# Host-based management tool for Docker Sandboxes running AI agents.
#
# Usage: foundry <command> [project] [options]
#
# Commands:
#   init/up/down  - project lifecycle (sandbox + policy + repos + agent)
#   status/logs   - inspection
#   attach/shell  - enter a running sandbox
#   rm/doctor     - teardown and diagnostics
#   policy/image  - escape hatches over sbx and the agent image
#
# The vm/agent/workspace/template/host/network domains are deprecated.
#

set -euo pipefail

# ============================================================================
# INITIALIZATION
# ============================================================================

# Determine script location and install prefix
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Allow override via FOUNDRY_BASE_DIR (set by release bundles)
FOUNDRY_BASE="${FOUNDRY_BASE_DIR:-$(realpath "${SCRIPT_DIR}/..")}"
FOUNDRY_LIB_DIR="${FOUNDRY_LIB_DIR:-}"

resolve_lib_dir() {
    local lib_candidate
    for lib_candidate in "$@"; do
        if [[ -z "$lib_candidate" ]]; then
            continue
        fi
        local resolved
        if resolved=$(realpath -m "$lib_candidate" 2>/dev/null); then
            lib_candidate="$resolved"
        fi
        if [[ -d "$lib_candidate" ]]; then
            echo "$lib_candidate"
            return 0
        fi
    done
    return 1
}

# Source library modules (search both repo and install locations)
LIB_DIR=$(resolve_lib_dir \
    "$FOUNDRY_LIB_DIR" \
    "${FOUNDRY_BASE}/lib/foundry" \
    "${FOUNDRY_BASE}/lib" \
    "${SCRIPT_DIR}/../lib")

if [[ -z "$LIB_DIR" ]]; then
    echo "Unable to locate Agent Foundry libraries" >&2
    exit 1
fi

source "${LIB_DIR}/utils.sh"
source "${LIB_DIR}/config.sh"
source "${LIB_DIR}/registry.sh"

# Sandbox stack (Docker Sandboxes)
source "${LIB_DIR}/sandbox.sh"
source "${LIB_DIR}/policy.sh"
source "${LIB_DIR}/project.sh"
source "${LIB_DIR}/agent-sandbox.sh"
source "${LIB_DIR}/commands.sh"

# Deprecated Firecracker stack - removed after one release
source "${LIB_DIR}/network.sh"
source "${LIB_DIR}/vm.sh"
source "${LIB_DIR}/agent.sh"
source "${LIB_DIR}/workspace.sh"

# Enable color output by default
export COLOR_OUTPUT="${COLOR_OUTPUT:-true}"

# Version (read from VERSION file, fallback to 0.1.0)
if [[ -f "${FOUNDRY_BASE}/VERSION" ]]; then
    FOUNDRY_VERSION=$(tr -d '[:space:]' < "${FOUNDRY_BASE}/VERSION")
else
    FOUNDRY_VERSION="0.1.0"
fi

# ============================================================================
# HELP FUNCTIONS
# ============================================================================

show_version() {
    echo "Agent Foundry v${FOUNDRY_VERSION}"
}

show_help() {
    cat << 'EOF'
Agent Foundry - isolated microVM sandboxes for AI agents

USAGE:
    foundry <command> [project] [options]
    foundry [--help | --version]

The project is inferred from the current directory when omitted.

COMMANDS:
    init <project>      Create volume root, config, policy rules and sandbox,
                        then clone declared repos inside it
    up [project]        Start sandbox, publish ports, clone missing repos,
                        start the agent (idempotent - run it any time)
    down [project]      Stop agent and sandbox, keeping all state
    status [project]    Sandbox, agent, repos, ports and policy; no project
                        lists everything
    logs [project]      Tail agent logs (-f to follow, --watcher for watcher)
    attach [project]    Attach to the agent's tmux session
    shell [project]     Shell inside the sandbox (--ssh to use ssh)
    rm [project]        Remove the sandbox; the volume root is kept
    doctor [project]    Check host, policy, ports and keys (--fix repairs)

    policy <action>     baseline | allow | deny | check | ls
    image <action>      build | push
    config <action>     get | set | edit | show

GLOBAL OPTIONS:
    -h, --help      Show this help message
    -v, --version   Show version
    --verbose       Enable verbose output
    --dry-run       Show what would be done without executing

EXAMPLES:
    foundry doctor --fix                  # set up the host and policy baseline
    foundry init pocetude                 # scaffold + sandbox + clone
    $EDITOR ~/.local/share/foundry/volumes/pocetude/.ssh/config
    foundry up                            # from inside the project
    foundry status
    foundry logs -f
    foundry shell

DEPRECATED (removed next release):
    vm, agent, workspace, template, host, network
    These are the pre-sandbox Firecracker commands. See 'foundry <domain> help'.

Documentation:
    https://github.com/yourusername/agent-foundry
EOF
}

show_vm_help() {
    cat << 'EOF'
foundry vm - VM lifecycle management

USAGE:
    foundry vm <action> [args...]

ACTIONS:
    create <name> [template]    Create new VM from template
    start <name>               Start a stopped VM
    stop <name>                Stop a running VM
    restart <name>             Restart a VM
    destroy <name>             Destroy VM (stop, delete disk, release network)
    ssh <name> [command...]    SSH into VM or run command
    list                       List all VMs
    status <name>              Show VM details
    ip <name>                  Get VM IP address
    copy <source> <dest>       Copy a VM
    rename <old> <new>         Rename a VM
    snapshot <name> <snap>     Create snapshot as template
    update <name>              Update AI dependencies (claude, gemini, codex, ralph, kimi)

EXAMPLES:
    foundry vm create my-project
    foundry vm create my-project arch-agent-golden.ext4
    foundry vm create my-project --ssh-key ~/.ssh/deploy_key
    foundry vm start my-project
    foundry vm ssh my-project
    foundry vm ssh my-project "uname -a"
    foundry vm list
    foundry vm copy my-project my-project-backup
    foundry vm snapshot my-project my-custom-template
EOF
}

show_agent_help() {
    cat << 'EOF'
foundry agent - AI agent session management

USAGE:
    foundry agent <action> [args...]

ACTIONS:
    start <vm> [type] [--thread <key>]
                               Start agent (type: ralph, ralph-orchestrator, kimi-ralph, claude, gemini, codex)
    stop <vm>                  Stop agent
    restart <vm>               Restart agent
    attach <vm>                Attach to agent session
    status <vm>                Show agent status
    logs <vm> [-f|--follow]    View agent logs
    sessions <vm>              List tracked thread sessions in the VM
    resume <vm> <thread-key>   Resume a tracked session for a thread
    enable-autostart <vm>      Enable agent autostart on boot
    disable-autostart <vm>     Disable agent autostart
    gh-watcher <action> <vm>      Manage GitHub watcher (see: foundry agent gh-watcher help)
    forgejo-watcher <action> <vm> Manage Forgejo watcher (see: foundry agent forgejo-watcher help)

AGENT TYPES:
    ralph   - ralph-claude-code autonomous agent (default, runs in tmux)
    ralph-orchestrator - ralph-orchestrator autonomous agent (runs in tmux)
    kimi-ralph - Kimi Code CLI autonomous agent in Ralph mode (runs in tmux)
    claude  - Claude Code CLI interactive session (runs in screen)
    gemini  - Gemini CLI interactive session (runs in screen)
    codex   - OpenAI Codex CLI interactive session (runs in screen)

EXAMPLES:
    foundry agent start my-project ralph
    foundry agent start my-project ralph-orchestrator
    foundry agent start my-project kimi-ralph --thread owner/repo#42
    foundry agent sessions my-project
    foundry agent resume my-project owner/repo#42
    foundry agent attach my-project
    foundry agent logs my-project --follow
    foundry agent stop my-project
    foundry agent enable-autostart my-project
    foundry agent gh-watcher init my-project
    foundry agent forgejo-watcher init my-project
EOF
}

show_gh_watcher_help() {
    cat << 'EOF'
foundry agent gh-watcher - Automated GitHub issue/PR monitoring

USAGE:
    foundry agent gh-watcher <action> <vm> [options]

DESCRIPTION:
    The GitHub watcher monitors repositories for !ralph mentions in issues
    and pull requests, automatically triggers the configured autonomous agent
    (Ralph or kimi-ralph) to work on tasks, and creates pull requests when
    complete. It supports multiple autonomous agent backends via adapter files.

ACTIONS:
    init <vm>              Initialize GitHub watcher (uses project gh-watcher.json if present, otherwise prompts)
    start <vm> [--new|--all] Start watcher daemon in background.
                           --new: Only process mentions from this moment on.
                           --all: Process all un-processed mentions from the last 30 days.
    stop <vm>              Stop watcher daemon
    status <vm>            Show watcher status and task queue
    logs <vm> [--follow]   View watcher logs
    reset <vm>             Clear processed task history
    mark-all <vm>          Mark all existing mentions as processed without running Ralph

WORKFLOW:
    1. User creates issue or PR comment with !ralph mention
    2. Watcher detects mention within 60 seconds
    3. Watcher builds agent-specific task context
    4. Watcher starts Ralph to work autonomously
    5. Ralph creates PR when complete (or posts error comment)
    6. Watcher resumes polling for new tasks

CONFIGURATION:
    Location: /root/.config/gh-watcher/ (inside VM)
    - config.conf      Watcher settings (repos, poll interval)
    - processed.json   Completed task history
    - watcher.log      Activity log

PROJECT CONFIG:
    Optional host-side config:
    ~/.config/foundry/projects/<project>/gh-watcher.json

GITHUB TOKEN:
    Required permissions (Fine-grained Personal Access Token):
    - Issues: Read and write
    - Pull requests: Read and write
    - Contents: Read only

    Create at: https://github.com/settings/tokens?type=beta

EXAMPLES:
    # Setup
    foundry agent gh-watcher init my-vm
    foundry agent gh-watcher start my-vm --new

    # Monitor
    foundry agent gh-watcher status my-vm
    foundry agent gh-watcher logs my-vm --follow

    # Maintenance
    foundry agent gh-watcher stop my-vm
    foundry agent gh-watcher mark-all my-vm

PRIORITY:
    1. !ralph in PR comments (fixes to existing PRs)
    2. !ralph in issues (new features/bugs)

For more information, see: docs/designs/2026-02-15-github-watcher-automation.md
EOF
}

show_forgejo_watcher_help() {
    cat << 'EOF'
foundry agent forgejo-watcher - Automated Forgejo issue/PR monitoring via webhooks

USAGE:
    foundry agent forgejo-watcher <action> <vm> [options]

DESCRIPTION:
    The Forgejo watcher registers webhooks on a self-hosted Forgejo instance,
    receives issue/PR events in real time, detects the configured trigger keyword,
    and starts the configured autonomous agent to work on tasks.

ACTIONS:
    init <vm>              Initialize Forgejo watcher (uses project forgejo-watcher.json if present, otherwise prompts)
    register-hooks <vm>    Create Forgejo webhooks on watched repositories
    start <vm>             Start watcher daemon and webhook receiver in background
    stop <vm>              Stop watcher daemon and receiver
    status <vm>            Show watcher, receiver, and agent status
    logs <vm> [--follow]   View watcher logs
    reset <vm>             Clear processed task history and queued events
    mark-all <vm>          Mark all existing trigger mentions as processed without running agent
    unregister-hooks <vm>  Remove Forgejo webhooks created by this integration

WORKFLOW:
    1. User creates issue or PR comment with trigger keyword mention
    2. Forgejo delivers webhook payload to the VM receiver
    3. Watcher verifies signature, builds agent-specific task context
    4. Watcher starts the autonomous agent
    5. Agent creates/updates PR when complete (or posts error comment)
    6. Watcher waits for the next webhook event

CONFIGURATION:
    Location: /root/.config/forgejo-watcher/ (inside VM)
    - config.conf      Watcher settings (instance URL, repos, receiver port)
    - processed.json   Completed task history
    - queue/           Incoming webhook events
    - watcher.log      Activity log

PROJECT CONFIG:
    Optional host-side config:
    ~/.config/foundry/projects/<project>/forgejo-watcher.json

FORGEJO TOKEN:
    Required permissions:
    - repository: write (to manage webhooks)
    - issue: write
    - pull_request: write

    Create at: Settings | Applications | Generate New Token

NETWORK REQUIREMENT:
    Forgejo must be able to reach the VM on the configured receiver port
    (default 8080). Ensure the host/VM is reachable from the Forgejo instance.

EXAMPLES:
    # Setup
    foundry agent forgejo-watcher init my-vm
    foundry agent forgejo-watcher register-hooks my-vm
    foundry agent forgejo-watcher start my-vm

    # Monitor
    foundry agent forgejo-watcher status my-vm
    foundry agent forgejo-watcher logs my-vm --follow

    # Maintenance
    foundry agent forgejo-watcher stop my-vm
    foundry agent forgejo-watcher unregister-hooks my-vm

PRIORITY:
    1. Trigger in PR review comments
    2. Trigger in issue/PR comments
    3. Trigger in issue/PR body

For more information, see: docs/FORGEJO-WATCHER.md
EOF
}

