# ============================================================================
# COMMAND ROUTING
# ============================================================================

cmd_vm() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        create)
            vm_create_cmd "$@"
            ;;
        start)
            vm_start "$@"
            ;;
        stop)
            vm_stop "$@"
            ;;
        restart)
            vm_restart "$@"
            ;;
        destroy)
            vm_destroy "$@"
            ;;
        ssh)
            vm_ssh "$@"
            ;;
        list|ls)
            vm_list
            ;;
        status|show)
            vm_status "$@"
            ;;
        ip)
            vm_ip "$@"
            ;;
        copy|cp)
            vm_copy "$@"
            ;;
        rename|mv)
            vm_rename "$@"
            ;;
        snapshot|snap)
            vm_snapshot "$@"
            ;;
        update)
            vm_update "$@"
            ;;
        help|--help|-h)
            show_vm_help
            ;;
        *)
            log_error "Unknown vm action: $action"
            echo "Run 'foundry vm help' for usage"
            return 1
            ;;
    esac
}

vm_create_cmd() {
    local VM_NAME="${1:-}"
    if [[ -z "$VM_NAME" ]]; then
        log_error "VM name required"
        echo "Usage: foundry vm create <name> [template] [-y|--yes] [--ssh-key <path>] [--project <name|path>]"
        return 1
    fi
    shift || true

    local TEMPLATE=""
    local SSH_KEY_PATH=""
    local PROJECT_NAME=""
    local PROJECT_DIR=""
    local AUTO_YES=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)
                AUTO_YES="-y"
                shift
                ;;
            --project)
                PROJECT_NAME="${2:-}"
                if [[ -z "$PROJECT_NAME" ]]; then
                    log_error "--project requires a project name or path"
                    return 1
                fi
                shift 2
                ;;
            --ssh-key)
                SSH_KEY_PATH="${2:-}"
                if [[ -z "$SSH_KEY_PATH" ]]; then
                    log_error "--ssh-key requires a key path"
                    return 1
                fi
                shift 2
                ;;
            --config)
                log_error "--config is no longer supported"
                return 1
                ;;
            -*)
                log_error "Unknown option: $1"
                return 1
                ;;
            *)
                if [[ -n "$TEMPLATE" ]]; then
                    log_error "Unexpected argument: $1"
                    return 1
                fi
                TEMPLATE="$1"
                shift
                ;;
        esac
    done

    if [[ -n "$PROJECT_NAME" ]]; then
        # Use actual user's home, not root's home when running with doas/sudo
        local HOST_HOME
        HOST_HOME="$(resolve_host_home)"
        local CONFIG_DIR="${XDG_CONFIG_HOME:-${HOST_HOME}/.config}/foundry/projects"

        # Auto-detect if it's a path (contains /)
        if [[ "$PROJECT_NAME" == */* ]]; then
            # Treat as path
            PROJECT_DIR="$PROJECT_NAME"
        else
            # Search for project in order: XDG config dir, then bundled
            if [[ -d "$CONFIG_DIR/$PROJECT_NAME" ]]; then
                PROJECT_DIR="$CONFIG_DIR/$PROJECT_NAME"
            elif [[ -d "${FOUNDRY_BASE}/projects/${PROJECT_NAME}" ]]; then
                PROJECT_DIR="${FOUNDRY_BASE}/projects/${PROJECT_NAME}"
            fi
        fi

        if [[ -z "$PROJECT_DIR" ]] || [[ ! -d "$PROJECT_DIR" ]]; then
            log_error "Project not found: $PROJECT_NAME"
            log_error "Searched in: $CONFIG_DIR and ${FOUNDRY_BASE}/projects"
            return 1
        fi
        if [[ ! -f "$PROJECT_DIR/git-config.json" ]]; then
            log_error "Project missing git-config.json: $PROJECT_DIR"
            return 1
        fi
    fi

    if [[ -n "$TEMPLATE" ]]; then
        if [[ -n "$SSH_KEY_PATH" ]]; then
            vm_create "$VM_NAME" $AUTO_YES --ssh-key "$SSH_KEY_PATH" "$TEMPLATE" || return 1
        else
            vm_create "$VM_NAME" $AUTO_YES "$TEMPLATE" || return 1
        fi
    else
        if [[ -n "$SSH_KEY_PATH" ]]; then
            vm_create "$VM_NAME" $AUTO_YES --ssh-key "$SSH_KEY_PATH" || return 1
        else
            vm_create "$VM_NAME" $AUTO_YES || return 1
        fi
    fi

    if [[ -n "$PROJECT_DIR" ]]; then
        # Start VM before workspace init (workspace_init requires running VM)
        log_info "Starting VM '$VM_NAME' for workspace initialization..."
        vm_start "$VM_NAME" || {
            log_error "Failed to start VM"
            return 1
        }

        # workspace_init expects path to git-config.json
        workspace_init "$VM_NAME" "$PROJECT_DIR/git-config.json"

        # Persist project metadata for future workspace sync operations.
        registry_update "$VM_NAME" ".project_dir" "\"$PROJECT_DIR\""
        registry_update "$VM_NAME" ".project_name" "\"$(basename "$PROJECT_DIR")\""
    fi
}

cmd_agent() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        start)
            agent_start "$@"
            ;;
        stop)
            agent_stop "$@"
            ;;
        restart)
            agent_restart "$@"
            ;;
        attach)
            agent_attach "$@"
            ;;
        status|show)
            agent_status "$@"
            ;;
        logs|log)
            agent_logs "$@"
            ;;
        sessions|session)
            agent_sessions "$@"
            ;;
        resume)
            agent_resume "$@"
            ;;
        enable-autostart)
            agent_enable_autostart "$@"
            ;;
        disable-autostart)
            agent_disable_autostart "$@"
            ;;
        gh-watcher)
            # GitHub watcher subcommands
            local gh_action="${1:-help}"
            shift || true
            case "$gh_action" in
                init)
                    agent_gh_watcher_init "$@"
                    ;;
                start)
                    agent_gh_watcher_start "$@"
                    ;;
                stop)
                    agent_gh_watcher_stop "$@"
                    ;;
                status)
                    agent_gh_watcher_status "$@"
                    ;;
                logs)
                    agent_gh_watcher_logs "$@"
                    ;;
                reset)
                    agent_gh_watcher_reset "$@"
                    ;;
                mark-all)
                    agent_gh_watcher_mark_all "$@"
                    ;;
                help|--help|-h)
                    show_gh_watcher_help
                    ;;
                *)
                    log_error "Unknown gh-watcher action: $gh_action"
                    echo "Run 'foundry agent gh-watcher help' for usage"
                    return 1
                    ;;
            esac
            ;;
        forgejo-watcher)
            local fj_action="${1:-help}"
            shift || true
            case "$fj_action" in
                init)
                    agent_forgejo_watcher_init "$@"
                    ;;
                register-hooks)
                    agent_forgejo_watcher_register_hooks "$@"
                    ;;
                start)
                    agent_forgejo_watcher_start "$@"
                    ;;
                stop)
                    agent_forgejo_watcher_stop "$@"
                    ;;
                status)
                    agent_forgejo_watcher_status "$@"
                    ;;
                logs)
                    agent_forgejo_watcher_logs "$@"
                    ;;
                reset)
                    agent_forgejo_watcher_reset "$@"
                    ;;
                mark-all)
                    agent_forgejo_watcher_mark_all "$@"
                    ;;
                unregister-hooks)
                    agent_forgejo_watcher_unregister_hooks "$@"
                    ;;
                help|--help|-h)
                    show_forgejo_watcher_help
                    ;;
                *)
                    log_error "Unknown forgejo-watcher action: $fj_action"
                    echo "Run 'foundry agent forgejo-watcher help' for usage"
                    return 1
                    ;;
            esac
            ;;
        help|--help|-h)
            show_agent_help
            ;;
        *)
            log_error "Unknown agent action: $action"
            echo "Run 'foundry agent help' for usage"
            return 1
            ;;
    esac
}

cmd_workspace() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        init)
            workspace_init "$@"
            ;;
        sync)
            workspace_sync "$@"
            ;;
        init-ralph)
            workspace_init_ralph "$@"
            ;;
        edit)
            workspace_edit "$@"
            ;;
        info|show)
            workspace_info "$@"
            ;;
        template)
            workspace_template "$@"
            ;;
        help|--help|-h)
            show_workspace_help
            ;;
        *)
            log_error "Unknown workspace action: $action"
            echo "Run 'foundry workspace help' for usage"
            return 1
            ;;
    esac
}

cmd_host() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        setup)
            if [[ -x "${FOUNDRY_BASE}/scripts/setup-host.sh" ]]; then
                exec "${FOUNDRY_BASE}/scripts/setup-host.sh" "$@"
            else
                log_error "setup-host.sh not found or not executable"
                return 1
            fi
            ;;
        status)
            echo "=== Host Status ==="
            echo ""
            echo "OS: $(detect_os)"
            echo ""
            echo "KVM Support:"
            if check_kvm; then
                echo "  Available and accessible"
            else
                echo "  Not available or not accessible"
            fi
            echo ""
            echo "Firecracker:"
            if check_command firecracker; then
                echo "  $(firecracker --version 2>&1 | head -1)"
            else
                echo "  Not installed"
            fi
            echo ""
            echo "Required Commands:"
            for cmd in jq ssh scp ip iptables; do
                if check_command "$cmd"; then
                    echo "  $cmd: found"
                else
                    echo "  $cmd: MISSING"
                fi
            done
            ;;
        help|--help|-h)
            show_host_help
            ;;
        *)
            log_error "Unknown host action: $action"
            echo "Run 'foundry host help' for usage"
            return 1
            ;;
    esac
}

cmd_network() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        init)
            network_init "$@"
            ;;
        status|show)
            network_status
            ;;
        cleanup)
            network_cleanup
            ;;
        help|--help|-h)
            show_network_help
            ;;
        *)
            log_error "Unknown network action: $action"
            echo "Run 'foundry network help' for usage"
            return 1
            ;;
    esac
}

cmd_config() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        get)
            config_get "$@"
            ;;
        set)
            config_set "$@"
            ;;
        edit)
            config_edit
            ;;
        show|list)
            config_load
            echo "=== Configuration ==="
            local _config_home
            _config_home="$(resolve_host_home)"
            if [[ -f "${FOUNDRY_CONFIG_DIR:-${_config_home}/.config/foundry}/config.conf" ]]; then
                cat "${FOUNDRY_CONFIG_DIR:-${_config_home}/.config/foundry}/config.conf"
            else
                echo "No user configuration (using defaults)"
            fi
            ;;
        help|--help|-h)
            show_config_help
            ;;
        *)
            log_error "Unknown config action: $action"
            echo "Run 'foundry config help' for usage"
            return 1
            ;;
    esac
}

cmd_template() {
    local action="${1:-help}"
    shift || true

    case "$action" in
        list|ls)
            echo "=== Available Templates ==="
            local _data_home
            _data_home="$(resolve_host_home)"
            local templates_dir="${FOUNDRY_DATA_DIR:-${_data_home}/.local/share/foundry}/vms/templates"
            if [[ -d "$templates_dir" ]]; then
                ls -lh "$templates_dir"/*.ext4 2>/dev/null || echo "No templates found"
            else
                echo "Templates directory not found: $templates_dir"
                echo "Run 'foundry host setup' first"
            fi
            ;;
        build)
            local template_type="${1:-help}"
            case "$template_type" in
                base)
                    if [[ -x "${FOUNDRY_BASE}/scripts/build-ubuntu-base.sh" ]]; then
                        exec "${FOUNDRY_BASE}/scripts/build-ubuntu-base.sh" "${@:2}"
                    else
                        log_error "build-ubuntu-base.sh not found"
                        return 1
                    fi
                    ;;
                golden)
                    if [[ -x "${FOUNDRY_BASE}/scripts/build-golden.sh" ]]; then
                        exec "${FOUNDRY_BASE}/scripts/build-golden.sh" "${@:2}"
                    else
                        log_error "build-golden.sh not found"
                        return 1
                    fi
                    ;;
                *)
                    echo "Usage: foundry template build <base|golden>"
                    ;;
            esac
            ;;
        help|--help|-h)
            echo "foundry template - Template management"
            echo ""
            echo "ACTIONS:"
            echo "    list              List available templates"
            echo "    build base        Build base Ubuntu template"
            echo "    build golden      Build golden template with AI tools"
            ;;
        *)
            log_error "Unknown template action: $action"
            return 1
            ;;
    esac
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    # Parse global options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            --verbose)
                export VERBOSE=true
                shift
                ;;
            --dry-run)
                export DRY_RUN=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                echo "Run 'foundry --help' for usage"
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # Get domain
    local domain="${1:-help}"
    shift || true

    # Route to command handler.
    # Verbs first (the project-centric CLI), then the deprecated noun domains.
    case "$domain" in
        init)
            cmd_init "$@"
            ;;
        up)
            cmd_up "$@"
            ;;
        down)
            cmd_down "$@"
            ;;
        status|st)
            cmd_status "$@"
            ;;
        logs|log)
            cmd_logs "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        shell|sh)
            cmd_shell "$@"
            ;;
        rm|remove)
            cmd_rm "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        policy)
            cmd_policy "$@"
            ;;
        image|img)
            cmd_image "$@"
            ;;
        vm)
            log_warn "'foundry vm' is deprecated and will be removed next release."
            log_warn "Use: foundry init / up / down / status / shell / rm"
            cmd_vm "$@"
            ;;
        agent)
            log_warn "'foundry agent' is deprecated and will be removed next release."
            log_warn "Use: foundry up / down / attach / logs"
            cmd_agent "$@"
            ;;
        workspace|ws)
            log_warn "'foundry workspace' is deprecated and will be removed next release."
            log_warn "Use: the volume root is the workspace - edit it directly"
            cmd_workspace "$@"
            ;;
        template|tpl)
            log_warn "'foundry template' is deprecated and will be removed next release."
            log_warn "Use: foundry image build"
            cmd_template "$@"
            ;;
        host)
            log_warn "'foundry host' is deprecated and will be removed next release."
            log_warn "Use: foundry doctor --fix"
            cmd_host "$@"
            ;;
        network|net)
            log_warn "'foundry network' is deprecated and will be removed next release."
            log_warn "Use: foundry policy"
            cmd_network "$@"
            ;;
        config|cfg)
            cmd_config "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            log_error "Unknown domain: $domain"
            echo ""
            echo "Commands: init, up, down, status, logs, attach, shell, rm, doctor, policy, image, config"
            echo "Run 'foundry --help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
