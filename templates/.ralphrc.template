# Ralph configuration for Agent Foundry VM
# This is the DEFAULT configuration template.
#
# To customize for a specific project:
# 1. Copy this file to your project directory: projects/your-project/.ralphrc
# 2. Modify the settings as needed
# 3. Copy it into the project's volume root; it is picked up live (no sync step).
#
# The project-specific .ralphrc will override this default template.

PROJECT_NAME="agent-foundry-vm"
PROJECT_TYPE="generic"

# Loop settings
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=15
CLAUDE_OUTPUT_FORMAT="json"

# Tool permissions - FULL ACCESS
# VMs have root access and run autonomously, so all tools are allowed
# This enables Claude to install dependencies, run commands, and manage the system
ALLOWED_TOOLS="Write,Read,Edit,Glob,Grep,Task,TodoWrite,WebFetch,WebSearch,NotebookEdit,Bash"

# Session management
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Circuit breaker thresholds
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70
