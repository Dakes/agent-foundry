#!/bin/bash
# Agent Foundry - goal-mode agent start script
#
# One template for claude-goal, codex-goal and agy-goal. All three CLIs ship a
# /goal command that keeps working across turns until a completion condition
# holds, so there is no loop to write here - only the invocation, which is the
# one thing that differs between them.
#
# Rendered by lib/agent-sandbox.sh, which exports AGENT_WORKSPACE, AGENT_TYPE,
# AGENT_LOG_FILE, AGENT_TASK_PROMPT_FILE and AGENT_GOAL_CONDITION.

# Without pipefail the status of `cmd | tee` is tee's, so a CLI that crashes
# immediately reports success to the watcher. And `exec` in a pipeline only
# replaces the subshell, so it buys nothing here - run the command and read
# PIPESTATUS instead.
set -o pipefail

cd "$AGENT_WORKSPACE" || {
    echo "ERROR: cannot change to workspace $AGENT_WORKSPACE" >&2
    exit 1
}

mkdir -p "$(dirname "$AGENT_LOG_FILE")"

# sbx exports ANTHROPIC_API_KEY=proxy-managed into every sandbox: a placeholder
# for a credential its proxy injects, which it only does for sandboxes it
# created for the claude agent. Foundry's are created as 'shell' (the image is
# its own), so nothing ever replaces the placeholder - and an API key, even a
# fake one, takes precedence over the account the CLI is logged into. The
# result is a 401 that reads as "Invalid API key" to someone who never set one.
#
# Only the placeholder is dropped. A real key that someone set deliberately
# still works.
for _var in ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY OPENAI_API_KEY; do
    if [[ "${!_var:-}" == "proxy-managed" ]]; then
        echo "[INFO] ignoring sbx placeholder ${_var}=proxy-managed"
        unset "$_var"
    fi
done
unset _var

if [[ ! -f "$AGENT_TASK_PROMPT_FILE" ]]; then
    echo "ERROR: task prompt not found: $AGENT_TASK_PROMPT_FILE" >&2
    echo "The watcher writes it before starting the agent." >&2
    exit 1
fi

if [[ -z "${AGENT_GOAL_CONDITION:-}" ]]; then
    echo "ERROR: no goal condition was rendered for $AGENT_TYPE" >&2
    exit 1
fi

# Work happens in the repository, not the volume root. All three CLIs anchor on
# a git repository; agy in particular falls back to an internal scratch
# workspace when it cannot find one, and then reports success for work it did
# somewhere else entirely.
if [[ -n "${AGENT_REPO_PATH:-}" ]]; then
    if [[ ! -d "$AGENT_REPO_PATH/.git" ]]; then
        echo "ERROR: not a git repository: $AGENT_REPO_PATH" >&2
        echo "Goal-mode agents anchor on the repository; without one they may" >&2
        echo "work in a scratch directory and report success for it." >&2
        exit 1
    fi
    cd "$AGENT_REPO_PATH" || exit 1
fi

# Written to stdout only. Whoever started this script owns the log file - the
# watcher tees the whole run, and a manual start tees it in tmux. Writing here
# as well put every line in two files, which is what made `foundry logs` show
# everything twice.
echo "[INFO] $AGENT_TYPE starting in $(pwd)"
echo "[INFO] goal: $AGENT_GOAL_CONDITION"

case "$AGENT_TYPE" in
    claude-goal)
        # stream-json is not optional: with the default text output /goal
        # prints nothing until the condition is met, so a long run is
        # indistinguishable from a hung one in `foundry logs -f`.
        #
        # Permissions are skipped, not merely relaxed. acceptEdits auto-approves
        # file writes but still prompts for Bash, and the fix and implement
        # conditions require committing, pushing and opening a pull request - a
        # loop that cannot run git can never satisfy them, so it would burn
        # every one of its turns failing. The sandbox is the boundary here, the
        # permission prompt is not.
        # Through the formatter: stream-json is unreadable as a log, and
        # keeping the raw form is not worth the disk. PIPESTATUS below still
        # reads the CLI's status, not the formatter's.
        claude -p "/goal ${AGENT_GOAL_CONDITION}" \
            --dangerously-skip-permissions \
            --output-format stream-json --verbose \
            2>&1 | python3 /opt/foundry/format-agent-stream.py
        ;;

    codex-goal)
        # The sandbox already isolates us, so codex's own sandbox only gets in
        # the way; --skip-git-repo-check keeps it from refusing an untrusted
        # directory. `goals` is a stable, default-on feature flag.
        codex exec \
            --skip-git-repo-check \
            --dangerously-bypass-approvals-and-sandbox \
            "/goal ${AGENT_GOAL_CONDITION}" 2>&1
        ;;

    agy-goal)
        # Flag order matters: -p takes the prompt as its value, so any flag
        # placed after it is swallowed as the prompt text. --print-timeout
        # defaults to 5 minutes, which would kill a long goal run mid-work.
        agy \
            --dangerously-skip-permissions \
            --print-timeout "${AGENT_GOAL_TIMEOUT:-4h}" \
            -p "/goal ${AGENT_GOAL_CONDITION}" 2>&1
        ;;

    *)
        echo "ERROR: start-goal.sh does not handle agent type: $AGENT_TYPE" >&2
        exit 1
        ;;
esac

# The CLI's status, not the formatter's.
exit "${PIPESTATUS[0]}"
